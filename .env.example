# ========================================================
# Brain & Muscle Multi-Agent Hub - Environment Template
# Copy this file to .env and adjust variables if needed.
# DO NOT COMMIT YOUR REAL .env TO VERSION CONTROL.
# ========================================================

# Workspace root directory (Defaults to current working directory if left empty)
WORKSPACE_PATH=""

# Inter-agent communication log (relative to workspace or absolute)
INTER_AGENT_LOG_PATH="logs/inter_agent_chat.jsonl"

# Default Model Selection
# Claude Models: "opus", "sonnet", "haiku"
CLAUDE_DEFAULT_MODEL="opus"
CLAUDE_EFFORT="medium"

# Antigravity Models: "gemini-3.8-flash", "gemini-2.5-pro", "gemini-2.5-flash"
AGY_DEFAULT_MODEL="gemini-3.8-flash"
AGY_EFFORT="high"

# Optional: Third-party API keys (if calling via REST API rather than CLI)
# OPENAI_API_KEY="your-openai-api-key-here"
# DEEPSEEK_API_KEY="your-deepseek-api-key-here"
# OPENROUTER_API_KEY="your-openrouter-api-key-here"
